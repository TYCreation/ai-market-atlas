{
  "name": "ai-market-atlas",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "#market-snapshot": "./data/market/current.json",
    "#market-monthly-index": "./data/market/monthly/index.json"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "pretest:market": "npm run market:browser:install && npm run market:browser:probe",
    "test:market": "node --experimental-strip-types --test tests/market-data/*.test.ts",
    "market:browser:install": "playwright install chromium",
    "market:browser:probe": "node --experimental-strip-types scripts/probe-market-browser.ts",
    "market:seed": "node --experimental-strip-types scripts/seed-market-snapshot.ts",
    "market:review": "node --experimental-strip-types scripts/market-review.ts",
    "market:validate": "node --experimental-strip-types scripts/market-update.ts validate",
    "market:promote": "node --experimental-strip-types scripts/market-update.ts promote",
    "market:prune": "node --experimental-strip-types scripts/market-update.ts prune",
    "market:brief": "node --experimental-strip-types scripts/generate-market-brief.ts",
    "market:export": "node --experimental-strip-types scripts/export-pages.ts",
    "market:deploy": "node --experimental-strip-types scripts/deploy-pages.ts",
    "check:hyperframes": "npm --prefix hyperframes/weekly-ai-market-brief run check",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "gsap": "^3.14.2",
    "playwright": "1.54.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
